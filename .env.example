# Aplikasi
NODE_ENV=development
PORT=3000

# Origin frontend yang diizinkan, pisahkan dengan koma.
CORS_ORIGINS=http://localhost:5173

# Database
DATABASE_URL="postgresql://<user>:<password>@localhost:5432/<database>?schema=public"

# Autentikasi
# JWT_SECRET minimal 32 karakter. Buat dengan: openssl rand -base64 48
JWT_SECRET=
# Access token sengaja berumur pendek karena sudah ada refresh token.
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Redis, untuk queue BullMQ
REDIS_HOST=localhost
REDIS_PORT=6379
# REDIS_PASSWORD=

# Google Gemini, dipakai untuk ekstraksi invoice
# Ambil API key di: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_TEMPERATURE=0.1

# Akun administrator awal yang dibuat oleh `npm run db:seed`
SEED_ADMIN_EMAIL=admin@ofda.local
SEED_ADMIN_PASSWORD=Admin123!
